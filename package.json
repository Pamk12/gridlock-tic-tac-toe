{
  "name": "gridlock-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "A polished browser Tic-Tac-Toe game with AI and local two-player modes.",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend --prefix-colors blue,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "dev:backend": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/server.js",
    "preview": "vite preview --config frontend/vite.config.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
